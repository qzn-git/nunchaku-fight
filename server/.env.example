# ===== 支付宝 AI 网页应用收款配置 =====
# 本文件为模板，复制为 .env 后填入沙箱/生产真实值
# 注意：生产环境敏感值（appId / 私钥 / 公钥）仅存本地，切勿提交到 Git

# 是否沙箱（默认 true）
ALIPAY_SANDBOX=true

# 沙箱网关（生产用 https://openapi.alipay.com/gateway.do）
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ===== 应用凭据（沙箱从 aipay.alipay.com/open-flow/products 技术集成节点获取） =====
# AppId
ALIPAY_APP_ID=

# 应用私钥 —— Node.js 使用 PKCS#1 格式（沙箱字段名 appPrivatePkcsKey）
# 直接粘贴原始字符串，不添加 PEM 头尾，不做格式转换
ALIPAY_APP_PRIVATE_KEY_PKCS1=

# 支付宝公钥（沙箱返回值原样填）
ALIPAY_PUBLIC_KEY=

# 签名算法（固定 RSA2）
ALIPAY_SIGN_TYPE=RSA2

# ===== 商家信息（可选，但推荐填；校验 notify 里的 seller_id/email） =====
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=

# ===== 回调地址 =====
# 同步回跳（必须是已实现的真实 GET 路由，沙箱可用内网穿透地址）
ALIPAY_RETURN_URL=http://localhost:3000/api/pay/return

# 异步通知（可选；为空则 SDK 不传 notify_url，服务端主动查单兜底）
# 沙箱阶段可用 ngrok/cpolar 内网穿透后的公网 https 地址，例如：
# ALIPAY_NOTIFY_URL=https://xxxx.ngrok-free.app/api/pay/notify
ALIPAY_NOTIFY_URL=

# ===== 服务端 =====
PORT=3000

# ===== 数据目录（订单 JSON 持久化位置） =====
DATA_DIR=./data
